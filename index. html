
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#101b2d">
<meta name="description" content="VIHA Group of Constructions. Quality our identity. Building with experience, trust and commitment since 2009.">
<title>VIHA Group of Constructions | Quality Our Identity</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
  --navy: #101b2d;
  --navy-light: #192941;
  --gold: #e7bd72;
  --gold-light: #f7dfaa;
  --ivory: #fffaf0;
  --cream: #f6f1e7;
  --text: #263348;
  --muted: #778092;
  --green: #284f3d;
  --white: #ffffff;
  --line: rgba(231,189,114,.28);
  --serif: 'Playfair Display', Georgia, serif;
  --sans: 'Manrope', sans-serif;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; scroll-padding-top: 85px; }

body {
  font-family: var(--sans);
  color: var(--text);
  background: var(--ivory);
  overflow-x: hidden;
}

body.menu-open { overflow: hidden; }

a { text-decoration: none; color: inherit; }
button { font: inherit; }
img { max-width: 100%; display: block; }

::selection { background: var(--gold); color: var(--navy); }

.container {
  width: min(1180px, 90%);
  margin: auto;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  text-transform: uppercase;
  letter-spacing: 3px;
  font-size: 10px;
  font-weight: 800;
  color: #a87631;
}

.eyebrow::before {
  content: "";
  height: 1px;
  width: 28px;
  background: currentColor;
}

.section-heading {
  font: 500 clamp(36px, 4.6vw, 62px)/1.12 var(--serif);
  letter-spacing: -1.5px;
  margin-top: 20px;
}

.section-heading em {
  font-weight: 400;
  color: #ad7d3e;
}

.section-copy {
  color: #70798a;
  line-height: 1.95;
  font-size: 14px;
  max-width: 620px;
  margin-top: 22px;
}

.gold-button {
  min-height: 54px;
  padding: 0 27px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  background: var(--gold);
  color: var(--navy);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.7px;
  border: 1px solid var(--gold);
  transition: .3s ease;
  cursor: pointer;
}

.gold-button:hover {
  background: var(--gold-light);
  transform: translateY(-3px);
}

.outline-button {
  color: var(--white);
  border: 1px solid rgba(255,255,255,.45);
  background: rgba(255,255,255,.04);
  min-height: 54px;
  padding: 0 25px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
  transition: .3s;
}

.outline-button:hover {
  border-color: var(--gold);
  color: var(--gold-light);
}

/* NAVIGATION */

.navbar {
  height: 94px;
  width: 100%;
  position: absolute;
  z-index: 100;
  top: 0;
  left: 0;
  display: flex;
  align-items: center;
  border-bottom: 1px solid rgba(255,255,255,.15);
  transition: background .35s, height .35s;
}

.navbar.scrolled {
  position: fixed;
  height: 76px;
  background: rgba(16,27,45,.97);
  backdrop-filter: blur(18px);
  border-bottom-color: var(--line);
  box-shadow: 0 8px 30px rgba(0,0,0,.1);
}

.nav-inner {
  width: min(1370px, 92%);
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.brand {
  display: flex;
  align-items: center;
  min-width: 210px;
  gap: 12px;
}

.brand img {
  width: 70px;
  height: 60px;
  object-fit: contain;
}

.brand-text { color: white; }

.brand-text strong {
  display: block;
  font-size: 12px;
  letter-spacing: 1px;
  line-height: 1.5;
}

.brand-text span {
  display: block;
  font-size: 9px;
  color: var(--gold);
  letter-spacing: 1.5px;
  margin-top: 3px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: clamp(16px, 2.2vw, 32px);
  list-style: none;
}

.nav-links a {
  color: rgba(255,255,255,.83);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .8px;
  transition: color .2s;
}

.nav-links a:hover { color: var(--gold-light); }

.nav-contact {
  color: var(--gold) !important;
  border: 1px solid var(--line);
  padding: 14px 18px;
}

.menu-toggle {
  display: none;
  color: white;
  background: transparent;
  border: 1px solid var(--line);
  padding: 9px 12px;
  cursor: pointer;
}

/* HERO */

.hero {
  position: relative;
  min-height: 780px;
  height: 100svh;
  max-height: 1000px;
  overflow: hidden;
  color: white;
  background: var(--navy);
  display: flex;
  align-items: center;
}

.hero-media, .hero-shade {
  position: absolute;
  inset: 0;
}

.hero-media {
  background-image: url("https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2400&q=90");
  background-position: center 54%;
  background-size: cover;
  animation: heroDrift 22s ease-in-out infinite alternate;
  transform: scale(1.03);
}

.hero-shade {
  background:
    linear-gradient(90deg, rgba(9,18,31,.92) 0%, rgba(9,18,31,.77) 40%, rgba(9,18,31,.22) 100%),
    linear-gradient(0deg, rgba(9,18,31,.65), transparent 40%);
}

@keyframes heroDrift {
  from { transform: scale(1.03) translateX(0); }
  to { transform: scale(1.12) translateX(-1%); }
}

.hero-grid {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .16;
  background-image:
    linear-gradient(rgba(255,255,255,.12) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.12) 1px, transparent 1px);
  background-size: 100px 100px;
  mask-image: linear-gradient(90deg, black, transparent 75%);
}

.hero-content {
  position: relative;
  z-index: 2;
  width: min(1180px, 90%);
  margin: 100px auto 0;
}

.hero-label {
  display: inline-flex;
  align-items: center;
  gap: 13px;
  color: var(--gold-light);
  letter-spacing: 3px;
  text-transform: uppercase;
  font-size: 10px;
  font-weight: 800;
  margin-bottom: 30px;
}

.hero-label::before {
  content: "";
  width: 38px;
  height: 1px;
  background: var(--gold);
}

.hero h1 {
  font: 500 clamp(52px, 7.4vw, 100px)/1.04 var(--serif);
  max-width: 900px;
  letter-spacing: -2.5px;
}

.hero h1 em {
  font-weight: 400;
  color: var(--gold-light);
}

.hero-description {
  max-width: 540px;
  font-size: 14px;
  line-height: 1.95;
  color: rgba(255,255,255,.76);
  margin-top: 28px;
}

.hero-actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-top: 35px;
}

.hero-bottom {
  position: absolute;
  bottom: 38px;
  left: 5%;
  right: 5%;
  display: flex;
  justify-content: space-between;
  align-items: end;
  z-index: 3;
}

.hero-note {
  color: rgba(255,255,255,.75);
  font-size: 10px;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.hero-note strong {
  display: block;
  font-size: 11px;
  color: var(--gold-light);
  margin-top: 8px;
  letter-spacing: 1px;
}

.scroll-indicator {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 9px;
  letter-spacing: 2px;
  color: white;
}

.scroll-line {
  height: 1px;
  width: 50px;
  background: var(--gold);
  animation: linePulse 2s infinite;
}

@keyframes linePulse {
  50% { transform: scaleX(.5); transform-origin: left; }
}

/* EXPERIENCE STRIP */

.experience-strip {
  background: var(--navy);
  color: white;
  border-top: 1px solid var(--line);
}

.strip-inner {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.strip-item {
  padding: 33px 28px;
  display: flex;
  align-items: center;
  gap: 18px;
  border-right: 1px solid rgba(255,255,255,.12);
}

.strip-item:last-child { border-right: 0; }

.strip-number {
  color: var(--gold);
  font: 500 38px/1 var(--serif);
  white-space: nowrap;
}

.strip-item strong {
  display: block;
  font-size: 11px;
  letter-spacing: 1px;
  margin-bottom: 6px;
}

.strip-item span:last-child {
  color: rgba(255,255,255,.58);
  font-size: 10px;
  line-height: 1.6;
}

/* ABOUT */

.about {
  padding: 125px 0;
  overflow: hidden;
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 95px;
}

.about-visual {
  position: relative;
  min-height: 560px;
}

.about-image {
  position: absolute;
  inset: 0 40px 40px 0;
  background: url("https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1200&q=85") center/cover;
  min-height: 500px;
}

.about-image::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(0deg, rgba(16,27,45,.35), transparent 60%);
}

.about-frame {
  position: absolute;
  top: 22px;
  right: 15px;
  bottom: 15px;
  left: 24px;
  border: 1px solid #d2ac69;
  pointer-events: none;
}

.about-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  background: var(--navy);
  color: white;
  width: 190px;
  padding: 28px 24px;
  border-top: 3px solid var(--gold);
}

.about-badge strong {
  display: block;
  font: 500 38px var(--serif);
  color: var(--gold-light);
}

.about-badge span {
  font-size: 9px;
  line-height: 1.8;
  letter-spacing: 1.2px;
  text-transform: uppercase;
}

.about-content .section-copy { max-width: 520px; }

.about-quote {
  border-left: 2px solid var(--gold);
  padding: 14px 0 14px 20px;
  margin-top: 26px;
  font: italic 18px/1.7 var(--serif);
  color: #38465a;
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
  color: #976a30;
  margin-top: 30px;
  border-bottom: 1px solid #d9bd91;
  padding-bottom: 10px;
}

/* JOURNEY */

.journey {
  padding: 110px 0;
  background: var(--cream);
}

.journey-head {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 40px;
  margin-bottom: 65px;
}

.journey-head .section-copy { max-width: 410px; }

.journey-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.journey-card {
  position: relative;
  background: white;
  padding: 35px 30px 32px;
  min-height: 270px;
  border: 1px solid rgba(16,27,45,.08);
  transition: transform .3s, box-shadow .3s;
}

.journey-card:hover {
  transform: translateY(-7px);
  box-shadow: 0 18px 50px rgba(16,27,45,.08);
}

.journey-card .year {
  font: 500 42px var(--serif);
  color: #b18346;
}

.journey-card .card-line {
  height: 1px;
  width: 48px;
  background: #d8bd90;
  margin: 22px 0;
}

.journey-card h3 {
  font-size: 17px;
  margin-bottom: 13px;
}

.journey-card p {
  font-size: 12px;
  color: var(--muted);
  line-height: 1.9;
}

.journey-card.featured {
  background: var(--navy);
  color: white;
  border-color: var(--navy);
}

.journey-card.featured p { color: rgba(255,255,255,.66); }
.journey-card.featured .year { color: var(--gold-light); }

/* FOUNDER */

.founder {
  background: var(--navy);
  color: white;
  padding: 120px 0;
  position: relative;
  overflow: hidden;
}

.founder::before {
  content: "VIHA";
  position: absolute;
  right: -40px;
  bottom: -90px;
  font: 800 clamp(170px, 28vw, 400px)/1 var(--sans);
  color: rgba(255,255,255,.025);
  pointer-events: none;
}

.founder-grid {
  position: relative;
  display: grid;
  grid-template-columns: .85fr 1.15fr;
  align-items: center;
  gap: 90px;
}

.founder-photo {
  min-height: 470px;
  background:
    linear-gradient(0deg, rgba(16,27,45,.25), transparent 55%),
    url("https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=1000&q=85") center/cover;
  position: relative;
}

.founder-photo::after {
  content: "";
  position: absolute;
  inset: 18px -18px -18px 18px;
  border: 1px solid var(--gold);
  z-index: 0;
}

.founder-content { position: relative; z-index: 1; }

.founder .section-heading { color: white; }

.founder .section-copy { color: rgba(255,255,255,.7); }

.founder-name {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
  color: var(--gold-light);
  margin-top: 30px;
}

.founder-role {
  font-size: 11px;
  color: rgba(255,255,255,.55);
  margin-top: 8px;
}

.founder-signature {
  font: italic 27px var(--serif);
  color: var(--gold);
  margin-top: 30px;
}

/* STRENGTHS */

.strengths {
  padding: 120px 0;
  background: white;
}

.strengths-heading {
  max-width: 700px;
  margin-bottom: 55px;
}

.strengths-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid #e9e3d8;
  border-left: 1px solid #e9e3d8;
}

.strength-card {
  padding: 36px 30px;
  min-height: 235px;
  border-right: 1px solid #e9e3d8;
  border-bottom: 1px solid #e9e3d8;
  transition: background .3s;
}

.strength-card:hover { background: #fff9ed; }

.strength-icon {
  color: #a77735;
  font-size: 26px;
  margin-bottom: 25px;
}

.strength-card h3 {
  font-size: 16px;
  margin-bottom: 12px;
}

.strength-card p {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.9;
}

/* VISION */

.vision {
  padding: 100px 0;
  background:
    linear-gradient(90deg, rgba(16,27,45,.96), rgba(16,27,45,.84)),
    url("https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=2200&q=85") center/cover fixed;
  color: white;
}

.vision-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 65px;
}

.vision-card {
  padding: 35px 0;
  border-top: 1px solid var(--line);
}

.vision-card h3 {
  font: 500 35px var(--serif);
  color: var(--gold-light);
  margin-bottom: 20px;
}

.vision-card p {
  color: rgba(255,255,255,.7);
  font-size: 13px;
  line-height: 2;
  max-width: 490px;
}

/* CLIENTS */

.clients {
  padding: 110px 0;
  background: var(--cream);
}

.clients-top {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 25px;
  margin-bottom: 45px;
}

.clients-note {
  max-width: 360px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.9;
}

.clients-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid #ded6c8;
  border-left: 1px solid #ded6c8;
}

.client {
  min-height: 115px;
  padding: 22px 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: rgba(255,255,255,.5);
  border-right: 1px solid #ded6c8;
  border-bottom: 1px solid #ded6c8;
  font-size: clamp(13px, 1.6vw, 19px);
  font-weight: 800;
  letter-spacing: 1px;
  color: #27354a;
  transition: background .3s, color .3s;
}

.client:hover {
  background: var(--navy);
  color: var(--gold-light);
}

/* CONTACT */

.contact {
  padding: 115px 0;
  background: var(--navy);
  color: white;
  position: relative;
  overflow: hidden;
}

.contact::after {
  content: "";
  position: absolute;
  right: -100px;
  top: -150px;
  width: 500px;
  height: 500px;
  border: 1px solid rgba(231,189,114,.12);
  border-radius: 50%;
  box-shadow: 0 0 0 60px rgba(231,189,114,.025),
              0 0 0 120px rgba(231,189,114,.02);
  pointer-events: none;
}

.contact-grid {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  gap: 90px;
  align-items: center;
  position: relative;
  z-index: 1;
}

.contact .section-heading { color: white; }
.contact .section-copy { color: rgba(255,255,255,.65); }

.contact-details {
  border-top: 1px solid var(--line);
}

.contact-row {
  display: flex;
  gap: 18px;
  padding: 23px 0;
  border-bottom: 1px solid rgba(255,255,255,.12);
}

.contact-symbol {
  color: var(--gold);
  font-size: 19px;
  width: 28px;
}

.contact-row small {
  display: block;
  font-size: 9px;
  letter-spacing: 2px;
  color: rgba(255,255,255,.5);
  text-transform: uppercase;
  margin-bottom: 9px;
}

.contact-row a, .contact-row p {
  font-size: 13px;
  color: white;
  overflow-wrap: anywhere;
}

.contact-row a:hover { color: var(--gold-light); }

/* FOOTER */

.footer {
  background: #0a1321;
  color: rgba(255,255,255,.65);
  padding: 35px 0 20px;
}

.footer-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 30px;
  padding-bottom: 28px;
  border-bottom: 1px solid rgba(255,255,255,.1);
}

.footer-brand {
  color: white;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.footer-brand span {
  display: block;
  color: var(--gold);
  font-size: 9px;
  margin-top: 8px;
  font-weight: 500;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 22px;
}

.footer-links a {
  font-size: 10px;
  transition: color .2s;
}

.footer-links a:hover { color: var(--gold); }

.footer-bottom {
  display: flex;
  justify-content: space-between;
  gap: 25px;
  flex-wrap: wrap;
  padding-top: 22px;
  font-size: 10px;
  line-height: 1.8;
}

.designer-credit {
  color: var(--gold-light);
  letter-spacing: .8px;
  font-weight: 700;
}

.designer-credit span {
  color: rgba(255,255,255,.55);
  font-weight: 400;
}

/* REVEAL ANIMATION */

.reveal {
  opacity: 0;
  transform: translateY(25px);
  transition: opacity .8s ease, transform .8s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
  }
  .reveal { opacity: 1; transform: none; }
}

/* RESPONSIVE */

@media (max-width: 1000px) {
  .nav-contact { display: none !important; }
  .about-grid, .founder-grid { gap: 50px; }
  .about-visual { min-height: 480px; }
  .about-image { min-height: 430px; }
  .journey-grid { gap: 14px; }
  .journey-card { padding: 27px 22px; }
  .strip-item { padding: 28px 18px; }
}

@media (max-width: 760px) {
  .navbar { height: 78px; }
  .brand { min-width: 0; gap: 8px; }
  .brand img { width: 53px; height: 48px; }
  .brand-text strong { font-size: 10px; }
  .brand-text span { font-size: 8px; letter-spacing: .8px; }

  .menu-toggle { display: block; }

  .nav-links {
    position: fixed;
    top: 0;
    right: -100%;
    width: min(340px, 86vw);
    height: 100dvh;
    background: #101b2d;
    padding: 105px 30px 40px;
    display: flex;
    align-items: stretch;
    flex-direction: column;
    gap: 0;
    transition: right .35s ease;
    box-shadow: -15px 0 40px rgba(0,0,0,.2);
  }

  .nav-links.open { right: 0; }

  .nav-links li { border-bottom: 1px solid rgba(255,255,255,.1); }

  .nav-links a {
    display: block;
    padding: 19px 0;
    font-size: 12px;
  }

  .nav-contact { display: block !important; border: 0; padding: 19px 0 !important; }

  .hero {
    min-height: 720px;
    height: 95svh;
    max-height: 900px;
  }

  .hero-media { background-position: 60% center; }

